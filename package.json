{
  "name": "easy-convert",
  "productName": "Easy Convert",
  "version": "0.1.0",
  "description": "Right-click any file in Windows (or Shift+drag it into Chrome) and convert it to anything from a radial wheel.",
  "private": true,
  "type": "module",
  "main": "src/desktop/main.js",
  "homepage": "https://github.com/AMIRAK-code/easy-converter-ext-desktop-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/AMIRAK-code/easy-converter-ext-desktop-app.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:ext": "node scripts/build.mjs extension",
    "build:desktop": "node scripts/build.mjs desktop",
    "start": "node scripts/build.mjs desktop && electron .",
    "menu:install": "node scripts/build.mjs desktop && electron . --register",
    "menu:uninstall": "electron . --unregister",
    "dist:win": "node scripts/build.mjs desktop --minify && electron-builder --win nsis",
    "dist:ext": "node scripts/build.mjs extension && node scripts/zip-extension.mjs",
    "convert": "node src/desktop/cli.js",
    "test": "node --test test/unit.test.js",
    "test:matrix": "node test/matrix.js --no-office"
  },
  "author": "Amir Akbari",
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "docx": "^9.12.0",
    "exif-reader": "^2.0.3",
    "ffmpeg-static": "^5.3.0",
    "heic-convert": "^2.1.0",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.amirak.easyconvert",
    "productName": "Easy Convert",
    "directories": {
      "buildResources": "installer",
      "output": "dist/installer"
    },
    "files": [
      "package.json",
      "src/shared/**",
      "src/desktop/**",
      "build/desktop/**",
      "!**/*.map",
      "!node_modules/pdfjs-dist/build/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.md"
    ],
    "asarUnpack": [
      "src/desktop/convert/office.ps1",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/@napi-rs/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/pdfjs-dist/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/desktop/icons/icon.ico",
      "artifactName": "Easy-Convert-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Easy Convert",
      "createDesktopShortcut": true,
      "include": "installer/installer.nsh",
      "installerIcon": "build/desktop/icons/icon.ico",
      "uninstallerIcon": "build/desktop/icons/icon.ico"
    },
    "electronLanguages": [
      "en-US",
      "it"
    ]
  }
}
